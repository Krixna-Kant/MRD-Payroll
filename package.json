{
  "name": "local-payroll",
  "version": "1.0.0",
  "description": "Professional payroll management for small to medium businesses",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.14.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "asar": "^3.2.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.localpayroll.app",
    "productName": "LocalPayroll",
    "copyright": "Copyright © 2026 LocalPayroll",
    "directories": {
      "output": "dist"
    },
    "win": {
      "sign": null,
      "signingHashAlgorithms": null,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalPayroll"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/electron-builder/**/*"
    ]
  }
}
